# EkklesiazousAI configuration. Copy to .env and fill in what you have.
# Every key is optional: without keys the server runs in demo mode (scripted meeting, mock AI).

# ---------- Server ----------
PORT=8787
HOST=0.0.0.0
# Public URL of this server (needed for Zoom RTMS webhooks and meeting bots, e.g. an ngrok URL)
PUBLIC_BASE_URL=http://localhost:8787
# Room snapshots and research logs (relative to Apps/Server)
DATA_DIRECTORY=./Data
# auto: mock providers when no LLM key is set / on: always mock / off: fail without keys
MOCK_MODE=auto

# ---------- Speech recognition (Japanese + English, real time) ----------
# auto picks Soniox, then AssemblyAI
SPEECH_PROVIDER=auto
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-6-pro

# ---------- Language models ----------
# auto: OpenAI when OPENAI_API_KEY is set, otherwise Anthropic
LLM_PROVIDER=auto
OPENAI_API_KEY=
# Reasoning effort of the OpenAI writer and deep models (none / minimal / low / medium / high)
OPENAI_REASONING_WRITER=none
OPENAI_REASONING_DEEP=medium
ANTHROPIC_API_KEY=
# Fast writer for gists, details, clarifications and anonymous concerns
# (empty = provider default: gpt-6-luna / claude-haiku-5-5)
MODEL_WRITER=
# Deep model for the issue map, rolling summary and deep research
# (empty = provider default: gpt-6.1-sol / claude-opus-5-5)
MODEL_DEEP=
# Trigger detector ("router"): auto prefers Cerebras, then Groq, then the writer model
ROUTER_PROVIDER=auto
# Race the fast host against the writer model when it is slow (hedged requests)
ROUTER_HEDGE=true
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---------- Search ----------
PARALLEL_API_KEY=
EXA_API_KEY=
# Optional: raises Semantic Scholar from blocked to 1 request/second
SEMANTIC_SCHOLAR_API_KEY=
# Optional: OpenAlex key and contact e-mail (polite pool)
OPENALEX_API_KEY=
OPENALEX_EMAIL=
IS_ACADEMIC_SEARCH_ENABLED=true

# ---------- Zoom RTMS (per-participant audio from Zoom) ----------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ---------- Meeting bot (Recall.ai, experimental; Google Meet / Teams / Zoom) ----------
RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1
MEETING_BOT_NAME=EkklesiazousAI

# ---------- Google Meet add-on (client) ----------
# Google Cloud project number of the Meet add-on
VITE_MEET_CLOUD_PROJECT_NUMBER=
